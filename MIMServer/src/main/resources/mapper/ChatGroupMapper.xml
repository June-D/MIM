<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.junesoon.mim.mapper.ChatGroupMapper">
    <resultMap id="BaseResultMap" type="com.junesoon.mim.entity.ChatGroup">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="owner_user" jdbcType="VARCHAR" property="ownerUser"/>
        <result column="group_id" jdbcType="VARCHAR" property="groupId"/>
        <result column="group_name" jdbcType="VARCHAR" property="groupName"/>
        <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, owner_user, group_id, group_name, crt_time
    </sql>
    <select id="selectChatGroupListByOwnerUser" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_chat_group
        where owner_user = #{username,jdbcType=VARCHAR}
    </select>
</mapper>
