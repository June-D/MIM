# MIM 服务端环境变量样例。复制到 /etc/mim/mim.env，权限设为 0600。
# 星号（*）标出的是「上线前必须改」的项。

# ---------- 数据库 ----------
MIM_DB_URL=jdbc:mysql://127.0.0.1:3306/mim_core?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8
MIM_DB_USERNAME=mim
MIM_DB_PASSWORD=*

# ---------- Redis ----------
MIM_REDIS_HOST=127.0.0.1
MIM_REDIS_PORT=6379
# 非本机 Redis 必须设置密码并启用 TLS，否则服务端拒绝启动
MIM_REDIS_PASSWORD=*

# ---------- 监听 ----------
# 0.0.0.0 = 直接对外；127.0.0.1 = 只允许本机反向代理访问（推荐配合代理终结 TLS）
MIM_BIND_ADDRESS=127.0.0.1
# 代理终结 TLS 时必须设 framework，否则 request.getScheme() 恒为 http，
# PlaintextRejectionFilter 会把所有请求挡成 403。
MIM_FORWARD_HEADERS=framework

# ---------- 应用内 TLS（与反向代理二选一）----------
# MIM_TLS_ENABLED=true
# MIM_TLS_PORT=8443
# MIM_TLS_KEYSTORE=/etc/mim/tls/mim-tls.p12
# MIM_TLS_KEYSTORE_PASSWORD=*
# 启用后 8080 明文会被拒绝（403），客户端必须用 https://
MIM_TLS_ENABLED=false

# ---------- 密钥（丢了会拒绝启动 / 无法解密）----------
# 32 字节 Base64：openssl rand -base64 32
MIM_MASTER_KEY=*
MIM_EMAIL_KEY=*
# 轮换时把旧钥放这里，确认无误后再删
# MIM_MASTER_KEY_PREVIOUS=
# 也支持从 Vault/AWS/GCP 取：stdout 必须是 Base64 32 字节
# MIM_MASTER_KEY_COMMAND=vault kv get -field=key secret/mim/master

# ---------- 存储 ----------
MIM_MEDIA_DIR=/var/lib/mim/media
MIM_AVATAR_DIR=/var/lib/mim/avatar
MIM_MEDIA_MAX_BYTES=18000000
# 媒体保留期（天）；0 = 永不清理
MIM_MEDIA_RETENTION_DAYS=30

# ---------- 邮件（找回密码）----------
# 未配置时找回密码会明确提示「邮件服务未配置」，其它功能不受影响
MIM_SMTP_HOST=
MIM_SMTP_PORT=465
MIM_SMTP_SSL=true
MIM_SMTP_USERNAME=
MIM_SMTP_PASSWORD=
MIM_MAIL_FROM=

# ---------- 可选能力（默认关闭）----------
MIM_SENDER_CERT_ENABLED=false
MIM_SENDER_TOKEN_ENABLED=false
MIM_ANONYMOUS_SEND_ENABLED=false
