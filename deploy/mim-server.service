# systemd 单元示例：放到 /etc/systemd/system/mim-server.service
#
# 前置：
#   useradd --system --home /var/lib/mim --shell /usr/sbin/nologin mim
#   mkdir -p /opt/mim /var/lib/mim/media /var/lib/mim/avatar
#   cp MIMServer-*.jar /opt/mim/mim-server.jar
#   cp deploy/mim.env.example /etc/mim/mim.env && chmod 600 /etc/mim/mim.env
[Unit]
Description=MIM 服务端
Documentation=https://github.com/June-D/MIM
After=network-online.target mysql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=mim
Group=mim
WorkingDirectory=/var/lib/mim
# 密钥只从环境文件读，不写进单元文件（单元文件会被 systemctl cat 看到）
EnvironmentFile=/etc/mim/mim.env
Environment=JAVA_HOME=/usr/lib/jvm/temurin-17-jdk

# 堆按机器调整；MIM 是无状态服务，可水平扩多实例
ExecStart=/usr/lib/jvm/temurin-17-jdk/bin/java \
  -XX:MaxRAMPercentage=70 \
  -XX:+UseG1GC \
  -jar /opt/mim/mim-server.jar

Restart=always
RestartSec=3
# 磁盘上只有密文与元数据，但密钥仍只在环境文件里
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mim
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# 优雅停机：等待在途请求与 WS 关闭
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
